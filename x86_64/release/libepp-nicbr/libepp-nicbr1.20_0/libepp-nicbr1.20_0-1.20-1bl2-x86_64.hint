category: Libs
requires: cygwin libgcc1 libssl3 libstdc++6 libxerces-c31
sdesc: "Partially implementation of the Extensible Provisioning Protocol (runtime)"
ldesc: "This is the LIBEPP-NICBR C++ library that partially implements the Extensible
Provisioning Protocol (EPP), as described in the Internet Drafts RFC3730bis to
RFC3734bis and RFC3735."
external-source: libepp-nicbr

