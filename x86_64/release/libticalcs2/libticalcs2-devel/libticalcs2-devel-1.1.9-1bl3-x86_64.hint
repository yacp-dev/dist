category: Libs
requires: libglib2.0-devel libticables2-devel libticalcs2_12 libtifiles2-devel pkg-config
sdesc: "Library for communication with TI calculators (development)"
ldesc: "The ticalcs library is a library built on top of the ticables/tifiles
libraries which handles all calculators through a common API."
external-source: libticalcs2

