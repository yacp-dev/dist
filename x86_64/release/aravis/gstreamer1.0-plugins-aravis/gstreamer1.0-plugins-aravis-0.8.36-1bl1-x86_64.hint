category: Video
requires: cygwin libaravis0.8_0 libglib2.0_0 libgstreamer1.0_0
sdesc: "GStreamer 1.0 aravis plugin"
ldesc: "Aravis is a glib/gobject based library for video acquisition using Genicam
cameras. It currently only implements an ethernet camera protocol used for
industrial cameras."
external-source: aravis

