category: Libs
requires: girepository-cairo1.0 girepository-GdkPixbuf2.0 girepository-Gee0.8 girepository-GLib2.0 girepository-Gtk3.0 girepository-Pango1.0 libglib2.0-devel libgranite6
sdesc: "Library that extends GTK with common widgets and utilities (GObject Introspection data)"
ldesc: "Granite is a companion library for GTK and GLib. Among other things, it
provides complex widgets and convenience functions designed for use in apps
built for elementary OS."
external-source: granite

