category: Libs
build-depends: cygport gettext-devel gobject-introspection libcairo-devel libgdk_pixbuf2.0-devel libgee0.8-devel libglib2.0-devel libgtk3-devel libintl-devel libpango1.0-devel vala
sdesc: "Library that extends GTK with common widgets and utilities (utilities)"
ldesc: "Granite is a companion library for GTK and GLib. Among other things, it
provides complex widgets and convenience functions designed for use in apps
built for elementary OS."
skip:

homepage: https://github.com/elementary/granite
license: LGPL-3.0-or-later AND GPL-2.0-or-later AND GPL-3.0-or-later AND LGPL-2.1-or-later
