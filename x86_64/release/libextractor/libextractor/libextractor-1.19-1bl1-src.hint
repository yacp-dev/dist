category: Libs
build-depends: cygport file-devel flac-devel gettext-devel libapparmor-devel libarchive-devel libbz2-devel libexiv2-devel libgdk_pixbuf2.0-devel libgif-devel libglib2.0-devel libgsf1-devel libgstinterfaces1.0-devel libgstreamer1.0-devel libiconv-devel libintl-devel libjpeg-devel libmpeg2-devel libsmf-devel libtiff-devel libvorbis-devel rpm-devel zlib-devel
sdesc: "Library to extract meta data from files (utilities)"
ldesc: "GNU Libextractor is a library used to extract meta data from files. The goal
is to provide developers of file-sharing networks, browsers or WWW-indexing
bots with a universal library to obtain simple keywords and meta data to match
against queries and to show to users instead of only relying on filenames.
libextractor contains the shell command extract that, similar to the
well-known file command, can extract meta data from a file and print the
results to stdout."
skip:

homepage: https://www.gnu.org/software/libextractor/
license: GPL-3.0-or-later
