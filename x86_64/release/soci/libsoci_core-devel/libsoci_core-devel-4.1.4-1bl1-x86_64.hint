category: Database
requires: libsoci_core4 libfmt-devel libiodbc-devel libmariadb-devel libpq-devel libsoci_empty-devel libsoci_mysql-devel libsoci_odbc-devel libsoci_postgresql-devel libsoci_sqlite3-devel libsqlite3-devel
sdesc: "C++ Database Access Library (development / core)"
ldesc: "SOCI is a database access library for C++ that makes the illusion of embedding
SQL queries in the regular C++ code, staying entirely within the Standard C++."
external-source: soci

