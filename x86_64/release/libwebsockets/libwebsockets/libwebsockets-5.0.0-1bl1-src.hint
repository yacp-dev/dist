category: Libs
build-depends: cygport libavcodec-devel libavformat-devel libavutil-devel libbrotli-devel libdbus1-devel libevent-devel libglib2.0-devel libsqlite3-devel libssl-devel libswresample-devel libswscale-devel libuv-devel zlib-devel
sdesc: "C Websockets Server Library (utilities)"
ldesc: "libwebsockets is a lightweight GPL2 http and websocket server that hides all
the protocol handshakes and detail from the user code driving the server."
