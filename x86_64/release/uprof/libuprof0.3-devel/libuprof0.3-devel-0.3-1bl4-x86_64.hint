category: Libs
requires: libdbus-glib_1-devel libglib2.0-devel libuprof0.3_0 pkg-config
sdesc: "Toolkit to assist in profiling applications in a domain specific way (development)"
ldesc: "UProf is an open source library providing a toolkit to assist in profiling
applications in a domain specific way and generating reports than can quickly
be digested and discussed."
external-source: uprof

