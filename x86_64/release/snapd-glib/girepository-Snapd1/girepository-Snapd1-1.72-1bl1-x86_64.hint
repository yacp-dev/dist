category: Libs
requires: girepository-GLib2.0 libglib2.0-devel libsnapd-glib1
sdesc: "Glib library for communicating with snapd (GObject Introspection data)"
ldesc: "snapd-glib is a library to allow GLib based applications access to snapd, the
daemon that controls Snaps."
external-source: snapd-glib

