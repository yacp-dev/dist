category: Libs
requires: cygwin libgcc1 libglib2.0_0 libQt5Core5 libsnapd-glib1 libstdc++6
sdesc: "Glib library for communicating with snapd (runtime / Qt)"
ldesc: "snapd-glib is a library to allow GLib based applications access to snapd, the
daemon that controls Snaps."
external-source: snapd-glib

