category: Database
build-depends: cygport gettext-devel libcairo-devel libgda5.0-devel libgee0.8-devel libglib2.0-devel libgranite-devel libgtk3-devel libgtksourceview4.0-devel libsecret1-devel libssh2-devel vala vala-granite vala-gtksourceview4.0
sdesc: "SQL Client built in Vala"
ldesc: "Sequeler is a native Linux SQL client built in Vala and Gtk. It allows you to
connect to your local and remote databases, write SQL in a handy text editor
with language recognition, and visualize SELECT results in a Gtk.Grid Widget."
skip:

homepage: https://github.com/ellie-commons/sequeler
license: GPL-3.0-or-later
