category: Libs
build-depends: cygport libcurl-devel
sdesc: "C library for parsing, writing, and creating XML files (licensing & readmes)"
ldesc: "nXML is a C library for parsing, writing and creating XML 1.0 and 1.1 files or
streams. It supports utf-8, utf-16be and utf-16le, ucs-4 (1234, 4321, 2143, 
2312)."
skip:

homepage: https://github.com/bakulf/libnxml
license: LGPL-2.1-or-later
