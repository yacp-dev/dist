category: Libs
requires: libgig14 pkg-config
sdesc: "Gigasampler file access library (development)"
ldesc: "libgig is a C++ library for loading, modifying existing and creating new
Gigasampler files and DLS (Downloadable Sounds) Level 1/2 files. The source
code package includes a couple of command line tools based on the library."
external-source: libgig

