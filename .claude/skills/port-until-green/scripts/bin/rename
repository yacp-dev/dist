#!/usr/bin/env bash
# Stand-in for util-linux's `rename FROM TO FILE...`, which macOS lacks
# and dorgann's bump_version.sh calls: replaces the first FROM in each
# name. Put this directory first on PATH when running bump_version.sh
# locally.
[[ "$1" == "--" ]] && shift
from="$1" to="$2"; shift 2
for f; do mv -- "$f" "${f/"$from"/$to}"; done
